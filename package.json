{
  "name": "bloum",
  "version": "0.21.0",
  "author": "Gil Balsiger <gil.balsiger@gmail.com>",
  "description": "A powerful library of modern web components for your design system.",
  "license": "MIT",
  "keywords": [
    "web-components",
    "custom-elements",
    "components",
    "ui",
    "library",
    "javascript"
  ],
  "homepage": "https://www.bloum.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/balsigergil/bloum.git"
  },
  "bugs": {
    "url": "https://github.com/balsigergil/bloum/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/cjs/bloum.cjs",
  "module": "dist/esm/bloum.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "npm run sb",
    "build": "rimraf dist && concurrently \"npm run build:js\" \"npm run build:css\" \"npm run build:types\" \"npm run build:llms\"",
    "build:js": "node scripts/bundle.js",
    "build:css": "node scripts/build-css.js",
    "build:types": "tsc -p tsconfig.types.json",
    "build:llms": "node scripts/build-llms.js",
    "build:website": "npm run build && npm run -w website build",
    "test": "playwright test",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"./**/*.{js,jsx,cjs,ts,tsx,css,html,json,yml}\"",
    "format:check": "prettier --check \"./**/*.{js,jsx,cjs,ts,tsx,css,html,json,yml}\"",
    "check": "npm run lint && npm run format:check && npm run build:website",
    "docs": "npm run start -w docs",
    "docs:build": "npm run build -w docs",
    "prepare": "husky",
    "release": "release-it",
    "sb": "storybook dev -p 6006 --no-open",
    "sb-build": "storybook build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "focus-trap": "^8.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/madimi-one": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.64.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-links": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/html-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "concurrently": "^10.0.6",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cssnano": "^9.9.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "^10.6.3",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "linkedom": "^0.18.14",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-nesting": "^14.0.3",
    "postcss-preset-env": "^11.6.1",
    "postcss-url": "^10.1.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "release-it": "^21.1.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6",
    "typescript-eslint": "^8.72.0",
    "vite": "^8"
  },
  "lint-staged": {
    "./src/**/*.ts": "eslint",
    "*.{js,jsx,cjs,ts,tsx,html,css,json,yml}": "prettier --write"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): ${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "draft": true
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "npm run build"
      ]
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md",
        "ignoreRecommendedBump": true
      }
    }
  },
  "workspaces": [
    "website"
  ]
}
